# ---------------------------------------------------------------------------
# Model server. No API key required - the model runs on your own hardware, so
# incident data, log contents and source metadata never leave the network.
# ---------------------------------------------------------------------------

# Local development (Ollama):
RCA_MODEL=qwen2.5:7b
RCA_BASE_URL=http://localhost:11434/v1

# Production (vLLM on the GPU box) - use a 32B-70B class instruct model:
# RCA_MODEL=Qwen/Qwen3-32B
# RCA_BASE_URL=http://gpu-host:8000/v1

# Self-hosted servers ignore this; the OpenAI SDK requires a non-empty string.
RCA_API_KEY=not-needed

# Generation timeout in seconds. A large model on a busy box is slow, and a
# premature timeout throws away the whole investigation.
RCA_TIMEOUT=600

# Guided decoding. True for vLLM and recent Ollama; set false for older servers.
RCA_JSON_SCHEMA=true

# ---------------------------------------------------------------------------
# Investigation strategy
#   agentic - the model chooses each next tool call. Needs a capable model.
#   guided  - code runs the proven query sequence; the model interprets it.
#   auto    - start agentic, drop to guided if the model ignores the tools.
# ---------------------------------------------------------------------------
RCA_STRATEGY=auto
RCA_MAX_TOOL_ITERATIONS=20
RCA_MAX_LOG_LINES=60
RCA_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Evidence sources
# ---------------------------------------------------------------------------
RCA_DATA_DIR=./data

# Optional: point the change source at a real git clone instead of data/changes.
# Git handles its own auth, so no token is needed.
RCA_GIT_REPO=

# Optional: owner/repo, used only to build links back to pull requests.
RCA_GITHUB_REPO=
